                  <td style={{ fontSize: 12, maxWidth: 160, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={c.hospede}>{c.hospede || '—'}</td>
                  <td style={{ fontSize: 12, color: 'var(--color-text-muted)' }}>{c.pontoVenda || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <PaginationControls currentPage={currentPage} totalPages={totalPages} totalItems={totalItems}
          nextPage={nextPage} prevPage={prevPage} goToPage={goToPage} />
      </div>
    </div>
  );
}

// ── Main Page ─────────────────────────────────────────────────────────────────

export default function RegistroReservasPage() {
  const { empresaId } = useParams();
  const navigate = useNavigate();
  const toast = useToast();
  const { empresas, activeEmpresa } = useEmpresa();
  const empresaCtx = empresas.find(e => e.id === empresaId) || activeEmpresa;

  const isHits    = empresaCtx?.sistemaFrontend === 'hits';
  const isConcept = empresaCtx && (
    String(empresaCtx.name || '').toUpperCase().includes('SAF ') ||
    String(empresaCtx.name || '').toUpperCase().includes('JM SCP')
  );

  const pageLabel = isHits
    ? 'Reservas & Consumos (HITS)'
    : isConcept
      ? 'Reservas (Concept)'
      : 'Reservas (HITs)';

  const { reservas, loading, saveReserva, deleteReserva, clearReservas, importReservas, checkDuplicates } = useRegistroReservas(empresaId);

  const [activeTab,  setActiveTab]  = useState(isHits ? 'resumo' : 'reservas');
  const [editing,    setEditing]    = useState(null);
  const [showModal,  setShowModal]  = useState(false);
  const [showImport, setShowImport] = useState(false);
  const [showAudit,  setShowAudit]  = useState(false);

  // ── Filters ────────────────────────────────────────────────────────────────
  const [search,       setSearch]       = useState('');
  const [checkinDe,    setCheckinDe]    = useState('');
  const [checkinAte,   setCheckinAte]   = useState('');
  const [checkoutDe,   setCheckoutDe]   = useState('');
  const [checkoutAte,  setCheckoutAte]  = useState('');
  const [filtroEmpresa,    setFiltroEmpresa]    = useState('');
  const [filtroCategoria,  setFiltroCategoria]  = useState('');
  const [filtroStatus,     setFiltroStatus]     = useState('');
  const [filtroCanceladas, setFiltroCanceladas] = useState(false);

  const resetFilters = () => {
    setSearch(''); setCheckinDe(''); setCheckinAte('');
    setCheckoutDe(''); setCheckoutAte('');
    setFiltroEmpresa(''); setFiltroCategoria('');
    setFiltroStatus(''); setFiltroCanceladas(false);
  };

  const hasFilters = search || checkinDe || checkinAte || checkoutDe || checkoutAte ||
    filtroEmpresa || filtroCategoria || filtroStatus || filtroCanceladas;

  const empresasOpts   = useMemo(() => [...new Set(reservas.map(r => r.empresa).filter(Boolean))].sort(), [reservas]);
  const categoriasOpts = useMemo(() => [...new Set(reservas.map(r => r.categoria).filter(Boolean))].sort(), [reservas]);

  const rows = useMemo(() => {
    let list = [...reservas];
    if (filtroCanceladas)  list = list.filter(r => r.status === 'Cancelada');
    else if (filtroStatus) list = list.filter(r => r.status === filtroStatus);
    if (filtroEmpresa)     list = list.filter(r => r.empresa   === filtroEmpresa);
    if (filtroCategoria)   list = list.filter(r => r.categoria === filtroCategoria);
    if (checkinDe)         list = list.filter(r => r.checkin  >= checkinDe);
    if (checkinAte)        list = list.filter(r => r.checkin  <= checkinAte);
    if (checkoutDe)        list = list.filter(r => r.checkout >= checkoutDe);
    if (checkoutAte)       list = list.filter(r => r.checkout <= checkoutAte);
    if (search) {
      const q = search.toLowerCase();
      list = list.filter(r =>
        (r.hospede || '').toLowerCase().includes(q) ||
        (r.voucher || '').toLowerCase().includes(q) ||
        (r.empresa || '').toLowerCase().includes(q) ||
        fmtDate(r.checkin).includes(q) ||
        fmtDate(r.checkout).includes(q)
      );
    }
    return list;
  }, [reservas, search, checkinDe, checkinAte, checkoutDe, checkoutAte,
      filtroEmpresa, filtroCategoria, filtroStatus, filtroCanceladas]);

  const duplicatesMap = useMemo(() => {
    if (!showAudit) return new Map();
    const grps = new Map();
    reservas.forEach(r => {
      const v = r.voucher?.trim();
      if (!v) return;
      if (!grps.has(v)) grps.set(v, []);
      grps.get(v).push(r);
    });
    for (const [k, arr] of grps.entries()) {
      if (arr.length <= 1) grps.delete(k);
    }
    return grps;
  }, [reservas, showAudit]);

  const kpis = useMemo(() => ({
    count:      rows.length,
    totalRN:    rows.reduce((s, r) => s + (r.rn           || 0), 0),
    totalValor: rows.reduce((s, r) => s + (r.valorReserva || 0), 0),
    canceladas: rows.filter(r => r.status === 'Cancelada').length,
    avgRN:      rows.length ? (rows.reduce((s, r) => s + (r.rn || 0), 0) / rows.length).toFixed(1) : 0,
  }), [rows]);

  const { currentRows, currentPage, totalPages, totalItems, goToPage, nextPage, prevPage } = usePagination(rows, 50);

  const handleSave = async (data) => {
    await saveReserva(data);
    toast.success(data.id ? 'Reserva atualizada!' : 'Reserva adicionada!');
    setShowModal(false); setEditing(null);
  };

  const handleDelete = async (id) => {
    if (!window.confirm('Deletar esta reserva?')) return;
    await deleteReserva(id);
    toast.info('Reserva removida.');
  };

  const handleImport = async (rows) => {
    const count = await importReservas(rows);
    toast.success(`${count} reservas importadas!`);
    return count;
  };

  const handleClearAll = async () => {
    if (!window.confirm('🚨 ATENÇÃO: Apagar COMPLETAMENTE todas as reservas desta empresa?')) return;
    await clearReservas();
    toast.info('Todas as reservas foram deletadas.');
  };

  const handleExportExcel = useCallback(() => {
    const data = rows.map(r => ({
      'Voucher':       r.voucher || '',
      'Inclusão':      r.inclusao || '',
      'Check-in':      fmtDate(r.checkin),
      'Check-out':     fmtDate(r.checkout),
      'RN':            r.rn,
      'Pax':           r.pax,
      'Hóspede':       r.hospede || '',
      'Empresa/OTA':   r.empresa || '',
      'Apto.':         r.apto || '',
      'Categoria':     r.categoria || '',
      'Tarifa (R$)':   r.tarifa,
      'Crédito (R$)':  r.credito,
      'Valor Diárias (R$)': r.diarias,
      'Valor Reserva (R$)': r.valorReserva,
      'Status':        r.status,
    }));
    exportToExcel(data, 'registro_reservas', pageLabel.replace(/\s+/g, '_'));
    toast.success('Excel exportado!');
  }, [rows, toast, pageLabel]);

  const handleExportPdf = useCallback(() => {
    const cols = [
      { label: 'Voucher',   getValue: r => r.voucher || '—' },
      { label: 'Check-in',  getValue: r => fmtDate(r.checkin) },
      { label: 'Check-out', getValue: r => fmtDate(r.checkout) },
      { label: 'RN',        getValue: r => r.rn },
      { label: 'Hóspede',   getValue: r => r.hospede || '—' },
      { label: 'Empresa',   getValue: r => r.empresa || '—' },
      { label: 'Apto',      getValue: r => r.apto || '—' },
      { label: 'Valor',     getValue: r => fmtCurrency(r.valorReserva) },
      { label: 'Status',    getValue: r => r.status },
    ];
    exportToPdf(pageLabel, cols, rows);
  }, [rows, pageLabel]);

  // Tab definitions
  const tabs = isHits
    ? [
        { id: 'resumo',   icon: '🏨', label: 'Resumo de Conta' },
        { id: 'consumos', icon: '🍽️', label: 'Consumos Lançados' },
      ]
    : [
        { id: 'reservas', icon: '📋', label: 'Reservas' },
      ];

  if (loading && activeTab === 'reservas') return <div className="contas-loading"><div className="spinner" /></div>;

  return (
    <div className="contas-page">
      {/* Back button + title */}
      <div style={{ marginBottom: 16, display: 'flex', alignItems: 'center', gap: 12 }}>
        <button onClick={() => navigate(-1)} className="btn btn-secondary"
          style={{ padding: '6px 12px', fontSize: 13, display: 'flex', gap: 6, alignItems: 'center', border: '1px solid var(--color-border)', width: 'fit-content' }}>
          ← Voltar
        </button>
        <h2 style={{ margin: 0, fontSize: 18, fontWeight: 700 }}>
          🏨 {pageLabel}
        </h2>
      </div>

      {/* Tab navigation (only shown if HITS empresa has multiple tabs) */}
      {tabs.length > 1 && (
        <TabNav tabs={tabs} active={activeTab} onChange={setActiveTab} />
      )}

      {/* ── Tab: Reservas ────────────────────────────────────────────────── */}
      {activeTab === 'reservas' && (
        <>
          {/* KPIs */}
          <div className="contas-kpis">
            <KPICard label={pageLabel} value={kpis.count}             icon="🏨" color="var(--color-accent)"
              sub={`RN médio: ${kpis.avgRN}`} onClick={hasFilters ? resetFilters : undefined} />
            <KPICard label="Room Nights"   value={kpis.totalRN + ' RN'} icon="🛏️" color="var(--color-blue)"   sub="total noites" />
            <KPICard label="Receita Total" value={fmtKPI(kpis.totalValor)} icon="💰" color="var(--color-green)"  sub="valor reservas" />
            <KPICard label="Canceladas"    value={kpis.canceladas}       icon="❌" color="var(--color-red)"
              sub="na seleção" active={filtroCanceladas}
              onClick={() => { setFiltroCanceladas(f => !f); setFiltroStatus(''); }} />
          </div>

          {/* Toolbar */}
          <div className="contas-toolbar card">
            <div className="contas-toolbar-row" style={{ justifyContent: 'space-between', flexWrap: 'wrap', gap: 12 }}>
              <div style={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 8, flex: '1 1 auto' }}>
                <input className="form-input" style={{ flex: 1, minWidth: 140, maxWidth: 280 }}
                  placeholder="🔍 Voucher, hóspede, empresa..."
                  value={search} onChange={e => setSearch(e.target.value)} />
                <select className="form-input" style={{ width: 145, flexShrink: 0 }} value={filtroEmpresa} onChange={e => setFiltroEmpresa(e.target.value)}>
                  <option value="">Todas empresas</option>
                  {empresasOpts.map(e => <option key={e} value={e}>{e}</option>)}
                </select>
                <select className="form-input" style={{ width: 115, flexShrink: 0 }} value={filtroCategoria} onChange={e => setFiltroCategoria(e.target.value)}>
                  <option value="">Todas cat.</option>
                  {categoriasOpts.map(c => <option key={c} value={c}>{c}</option>)}
                </select>
                <select className="form-input" style={{ width: 130, flexShrink: 0 }} value={filtroStatus}
                  onChange={e => { setFiltroStatus(e.target.value); setFiltroCanceladas(false); }}>
                  <option value="">Todos status</option>
                  {['Realizada', 'Cancelada', 'No-Show', 'Pendente'].map(s => <option key={s} value={s}>{s}</option>)}
                </select>
                <span style={{ fontSize: 12, color: 'var(--color-text-muted)', whiteSpace: 'nowrap' }}>
                  {rows.length} resultado{rows.length !== 1 ? 's' : ''}
                </span>
                {hasFilters && (
                  <button className="btn btn-ghost btn-sm" onClick={resetFilters} style={{ color: 'var(--color-yellow)', flexShrink: 0 }}>✕ Limpar</button>
                )}
              </div>
              <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 8, flexShrink: 0 }}>
                <button className="btn btn-ghost btn-sm" onClick={handleExportExcel}>📊 Excel</button>
                <button className="btn btn-ghost btn-sm" onClick={handleExportPdf}>🖨️ PDF</button>
                <div style={{ width: 1, height: 24, background: 'var(--color-border)', margin: '0 4px' }} />
                <button className="btn btn-ghost btn-sm" style={{ color: 'var(--color-red)' }} onClick={handleClearAll}>🗑 Svuota Tudo</button>
                <button className="btn btn-ghost btn-sm" style={{ color: 'var(--color-yellow)', border: '1px solid rgba(251,191,36,0.5)' }} onClick={() => setShowAudit(true)}>🕵️ Audit Clones</button>
                <button className="btn btn-secondary btn-sm" onClick={() => setShowImport(true)}>📥 Importar</button>
                <button className="btn btn-primary btn-sm" onClick={() => { setEditing(null); setShowModal(true); }}>+ HIT Manual</button>
              </div>
            </div>
            <div className="contas-toolbar-row" style={{ marginTop: 8, flexWrap: 'wrap', gap: 8, alignItems: 'center' }}>
              <label style={{ fontSize: 12, color: 'var(--color-text-muted)', whiteSpace: 'nowrap' }}>Check-in de:</label>
              <input type="date" className="form-input" style={{ width: 145 }} value={checkinDe}   onChange={e => setCheckinDe(e.target.value)} />
              <label style={{ fontSize: 12, color: 'var(--color-text-muted)' }}>até:</label>
              <input type="date" className="form-input" style={{ width: 145 }} value={checkinAte}  onChange={e => setCheckinAte(e.target.value)} />
              <div style={{ width: 1, height: 24, background: 'var(--color-border)', margin: '0 4px' }} />
              <label style={{ fontSize: 12, color: 'var(--color-text-muted)', whiteSpace: 'nowrap' }}>Check-out de:</label>
              <input type="date" className="form-input" style={{ width: 145 }} value={checkoutDe}  onChange={e => setCheckoutDe(e.target.value)} />
              <label style={{ fontSize: 12, color: 'var(--color-text-muted)' }}>até:</label>
              <input type="date" className="form-input" style={{ width: 145 }} value={checkoutAte} onChange={e => setCheckoutAte(e.target.value)} />
            </div>
          </div>

          {/* Table */}
          <div className="card" style={{ overflow: 'auto' }}>
            {rows.length === 0 ? (
              <div className="empty-state">
                <div className="empty-state-icon">🏨</div>
                <div className="empty-state-text">
                  {reservas.length === 0 ? 'Nenhuma reserva cadastrada' : 'Nenhuma reserva nos filtros atuais'}
                </div>
                {reservas.length === 0 && (
                  <div style={{ display: 'flex', gap: 10, marginTop: 8 }}>
                    <button className="btn btn-secondary" onClick={() => setShowImport(true)}>📥 Importar Excel</button>
                    <button className="btn btn-primary" onClick={() => { setEditing(null); setShowModal(true); }}>+ HIT Manual</button>
                  </div>
                )}
              </div>
            ) : (
              <table className="data-table">
                <thead>
                  <tr>
                    <th>Voucher</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th style={{ textAlign: 'center' }}>RN</th>
                    <th>Pax</th>
                    <th>Hóspede</th>
                    <th>Empresa</th>
                    <th>Apto</th>
                    <th>Cat.</th>
                    <th style={{ textAlign: 'right' }}>Valor Reserva</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  {currentRows.map(r => (
                    <tr key={r.id} style={{ opacity: r.status === 'Cancelada' ? 0.5 : 1 }}>
                      <td style={{ fontFamily: 'var(--font-mono)', fontSize: 12 }}>{r.voucher}</td>
                      <td style={{ fontFamily: 'var(--font-mono)', fontSize: 12 }}>{fmtDate(r.checkin)}</td>
                      <td style={{ fontFamily: 'var(--font-mono)', fontSize: 12 }}>{fmtDate(r.checkout)}</td>
                      <td style={{ textAlign: 'center', fontWeight: 700 }}>{r.rn}</td>
                      <td style={{ fontSize: 12 }}>{r.pax || '—'}</td>
                      <td style={{ maxWidth: 180 }}>
                        <span style={{ display: 'block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={r.hospede}>{r.hospede || '—'}</span>
                      </td>
                      <td style={{ fontSize: 12 }}>{r.empresa || '—'}</td>
                      <td style={{ fontFamily: 'var(--font-mono)', fontSize: 12 }}>{r.apto || '—'}</td>
                      <td><span className="badge badge-accent" style={{ fontSize: 10 }}>{r.categoria}</span></td>
                      <td style={{ textAlign: 'right', fontFamily: 'var(--font-mono)', fontWeight: 700, color: 'var(--color-green)' }}>
                        {fmtCurrency(r.valorReserva)}
                      </td>
                      <td>
                        <span className={`badge ${r.status === 'Cancelada' ? 'badge-red' : r.status === 'Realizada' ? 'badge-green' : 'badge-yellow'}`}>
                          {r.status}
                        </span>
                      </td>
                      <td>
                        <div style={{ display: 'flex', gap: 4 }}>
                          <button className="btn btn-ghost btn-sm" onClick={() => { setEditing(r); setShowModal(true); }}>✏️</button>
                          <button className="btn btn-ghost btn-sm" style={{ color: 'var(--color-red)' }} onClick={() => handleDelete(r.id)}>×</button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            <PaginationControls currentPage={currentPage} totalPages={totalPages} totalItems={totalItems}
              nextPage={nextPage} prevPage={prevPage} goToPage={goToPage} />
          </div>
        </>
      )}

      {/* ── Tab: Resumo de Conta ─────────────────────────────────────────── */}
      {activeTab === 'resumo' && isHits && (
        <ResumoTab empresaId={empresaId} />
      )}

      {/* ── Tab: Consumos Lançados ───────────────────────────────────────── */}
      {activeTab === 'consumos' && isHits && (
        <ConsumosTab empresaId={empresaId} />
      )}

      {/* Modals */}
      {showModal && (
        <ReservaModal reserva={editing} onSave={handleSave} onClose={() => { setShowModal(false); setEditing(null); }} />
      )}
      {showImport && (
        <ImportReservasModal checkDuplicates={checkDuplicates} onImport={handleImport}
          onClose={(count) => { setShowImport(false); if (count > 0) toast.success(`${count} reservas importadas!`); }} />
      )}

      {/* Audit Modal */}
      {showAudit && (
        <div className="modal-overlay" onClick={() => setShowAudit(false)}>
          <div className="modal-box" onClick={e => e.stopPropagation()} style={{ width: 800, maxWidth: '95vw', maxHeight: '90vh', overflowY: 'auto' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
              <h2 className="modal-title" style={{ margin: 0 }}>🕵️ Auditoria de Duplicatas</h2>
              <button className="btn btn-ghost btn-sm" onClick={() => setShowAudit(false)}>✕</button>
            </div>
            <p style={{ fontSize: 13, color: 'var(--color-text-muted)', marginBottom: 20 }}>
              Vouchers com mais de um registro no banco de dados.
            </p>
            {duplicatesMap.size === 0 ? (
              <div className="empty-state card fade-in" style={{ padding: 40, background: 'var(--color-bg-secondary)' }}>
                <div style={{ fontSize: 32, marginBottom: 10 }}>🎉</div>
                <strong>Base de dados limpa!</strong>
                <div style={{ fontSize: 13, color: 'var(--color-text-muted)', marginTop: 4 }}>Nenhuma duplicata encontrada.</div>
              </div>
            ) : (
              <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }} className="fade-in">
                {Array.from(duplicatesMap.entries()).map(([voucher, list]) => (
                  <div key={voucher} style={{ background: 'var(--color-bg-primary)', padding: 12, borderRadius: 8, border: '1px solid rgba(251,191,36,0.4)' }}>
                    <h4 style={{ margin: '0 0 12px 0', color: 'var(--color-yellow)', display: 'flex', alignItems: 'center', gap: 8 }}>
                      <span>Voucher: {voucher}</span>
                      <span style={{ fontSize: 11, fontWeight: 'normal', color: 'var(--color-text-primary)', background: 'rgba(255,255,255,0.1)', padding: '2px 6px', borderRadius: 4 }}>
                        {list.length} registros
                      </span>
                    </h4>
                    <table className="data-table" style={{ fontSize: 12, width: '100%', margin: 0 }}>
                      <thead><tr style={{ background: 'var(--color-bg-hover)' }}>
                        <th>Data IN/OUT</th><th>Hóspede</th><th style={{ textAlign: 'right' }}>Valor HITs</th><th style={{ width: 80, textAlign: 'center' }}>Ação</th>
                      </tr></thead>
                      <tbody>
                        {list.map(r => (
                          <tr key={r.id}>
                            <td style={{ fontFamily: 'var(--font-mono)' }}>{fmtDate(r.checkin)} - {fmtDate(r.checkout)}</td>
                            <td style={{ maxWidth: 200, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={r.hospede}>{r.hospede || '—'}</td>
                            <td style={{ color: 'var(--color-green)', fontWeight: 600, fontFamily: 'var(--font-mono)', textAlign: 'right' }}>{fmtCurrency(r.valorReserva)}</td>
                            <td style={{ textAlign: 'center' }}>
                              <button className="btn btn-ghost btn-sm" style={{ color: 'var(--color-red)', padding: '4px 8px', fontSize: 12, background: 'rgba(239,68,68,0.1)' }}
                                onClick={() => handleDelete(r.id)}>🗑 Excluir</button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
