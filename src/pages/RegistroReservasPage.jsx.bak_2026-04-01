    return list;
  }, [consumos, search, filterConta, filterDepto]);

  const kpis = useMemo(() => ({
    total:    consumos.length,
    filtered: rows.length,
    vlTotal:  rows.reduce((s, c) => s + (c.total || 0), 0),
    contas:   new Set(rows.map(c => c.conta)).size,
